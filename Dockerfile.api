# Dockerfile for the FastAPI backend
FROM python:3.13.0-slim

WORKDIR /app

# Install system dependencies (libpq-dev required for psycopg/PostgreSQL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==2.1.3

COPY pyproject.toml poetry.lock* ./

# Install into the image's Python, without a virtualenv
RUN poetry config virtualenvs.create false

RUN poetry install --no-interaction --no-ansi --no-root

COPY nexa/ ./nexa/
COPY api_data/ ./api_data/
COPY docker/preflight.sh /usr/local/bin/preflight
RUN chmod +x /usr/local/bin/preflight

ENV PYTHONPATH=/app

EXPOSE 8000

# Run the API, aborting early if port 8000 is already taken
ENTRYPOINT ["preflight", "8000"]
CMD ["uvicorn", "nexa.api.agent_api:app", "--host", "0.0.0.0", "--port", "8000"]
