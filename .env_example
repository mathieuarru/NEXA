##################  LLM SETTINGS  ##################
# Set a key for at least one provider, or use Ollama for local models.
# Keys entered in the web interface (Settings > API Keys) take precedence.
# Leave a key empty to disable that provider. Formats:
#   OPENAI_API_KEY=sk-proj-...        ANTHROPIC_API_KEY=sk-ant-...
#   GOOGLE_API_KEY=AIza...            AZURE_API_KEY=<Azure portal key>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_API_KEY=

# Azure OpenAI only. Examples:
#   AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#   AZURE_OPENAI_API_VERSION=2024-02-15-preview
#   AZURE_OPENAI_CHAT_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Default model per provider, preselected in the web interface (optional).
# DEFAULT_MODEL_NAME is the OpenAI default; Azure uses AZURE_OPENAI_CHAT_DEPLOYMENT.
# Examples: ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
#           GOOGLE_DEFAULT_MODEL=gemini-2.0-flash
DEFAULT_MODEL_NAME=gpt-5-mini
ANTHROPIC_DEFAULT_MODEL=
GOOGLE_DEFAULT_MODEL=
OLLAMA_DEFAULT_MODEL=qwen3:14b-q8_0
# OLLAMA_BASE_URL: optional, default http://localhost:11434. Docker Compose sets it.

# Provider and model used by the NEXA benchmark runner (benchmark/benchmark.py).
BENCHMARK_PROVIDER=openai
BENCHMARK_MODEL_NAME=gpt-5-mini

##################  NEO4J SETTINGS (BENCHMARK OR FALLBACK)  ##################
# Graph used when a request or a benchmark run names no KG profile.
# Profiles are defined in api_data/kg_profiles.json.
NEO4J_HOST=localhost
NEO4J_PORT=7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DB_NAME=neo4j

##################  POSTGRES SETTINGS  ##################
# Conversation checkpoints and the Flex result store.
DB_URI=postgresql://langgraph_user:password@localhost:5432/langgraph_db

##################  AGENT SETTINGS  ##################
# Default reasoning mode: "direct" (fixed pipeline) or "flex" (agent with tools
# and result store). The API's `agent_mode` parameter overrides it per request.
NEXA_AGENT_MODE=direct
# Flex: maximum number of graph steps per question (about 2 per tool call).
NEXA_AGENT_RECURSION_LIMIT=200
# Direct: always replace the user_query argument of the retrieve_data_from_kg
# tool with the original question, for models that misformat tool arguments.
NEXA_FORCE_INJECT_USER_QUERY=false

##################  CONTEXT WINDOW & MEMORY  ##################
# All optional; the defaults are set in the code.
# NEXA_LLM_CONTEXT_WINDOW: context window in tokens. When unset, it is looked up
# from the model name (gpt-4o-mini=128k, claude=200k, gemini-1.5-pro=2M,
# llama=8k, ...); unknown models get 8000.
# NEXA_LLM_CONTEXT_WINDOW=128000

# Tokens reserved for the model's response.
# NEXA_OUTPUT_RESERVE=4000

# Tokens reserved for the system prompt, output schema, tool definitions and
# user message.
# NEXA_OTHER_RESERVE=5000

# Maximum tokens generated by one LLM call, and by the property-selection call.
# A call that ends below the cap is unaffected; the caps stop repetition loops
# in local models.
# NEXA_LLM_MAX_OUTPUT_TOKENS=32768
# NEXA_LLM_MAX_PROPERTY_TOKENS=1024

##################  PROPERTY CORRECTION  ##################
# "composite" (default): candidate values found in the database by containment
# and token overlap, then reranked. "legacy": all distinct values, ranked by
# string similarity only.
NEXA_PROPERTY_MATCHING=composite

# Seconds a fetched graph schema is cached (0 disables the cache).
# NEXA_SCHEMA_CACHE_TTL=300

##################  OPTIONAL BEHAVIOURS (OFF BY DEFAULT)  ##################
# Off by default, as in the published benchmark runs; each run records the
# values it used in its .meta.json. See nexa/config/params.py.
# Flex: mark a result truncated by the query's own trailing LIMIT as incomplete,
# so that no absence is concluded from it.
# NEXA_COMPLETENESS_GUARD=false
# Flex: add a rule against LIMIT in answer queries to the system prompt.
# NEXA_NO_LIMIT_PROMPT=false
# Flex: when the agent ends without a typed answer, rebuild it once with
# constrained decoding. Useful for small local models.
# NEXA_FLEX_ANSWER_RESCUE=false

##################  LOGGING & UI  ##################
# LOG_LEVEL=INFO
# Directory of kg_profiles.json, agent_presets.json, kg_descriptions/ and kg_examples/.
# KG_PROFILES_DIR=api_data

# API address used by the web interface (both default to http://localhost:8000).
# API_URL is used by the Streamlit server (Docker Compose sets it);
# BROWSER_API_URL is used by the browser and must be reachable from it.
# API_URL=http://localhost:8000
# BROWSER_API_URL=http://localhost:8000

##################  ABLATION SWITCHES (EXPERIMENTS ONLY)  ##################
# Each switch removes one component. benchmark/ablation_direct.py sets them
# per run; leave them false.
# NEXA_ABLATE_EMPTY_RESULT_LOOP=false
# NEXA_ABLATE_DB_MATCHING=false
# NEXA_ABLATE_LLM_SELECTION=false
# NEXA_ABLATE_SYNTAX_CORRECTION=false
# NEXA_ABLATE_FEWSHOT_EXAMPLES=false
