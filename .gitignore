# Python
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.venv/
*.egg-info/
build/
dist/

# Secrets & local config
.env
.env.local

# Editor / OS
.vscode/
.idea/
.DS_Store

# BioHopR source data (benchmark/datasets/biohopr/download_biohopr.sh)
benchmark/datasets/biohopr/data/

# Benchmark run logs
benchmark/**/*.log
benchmark/debug/

# Rendered figures (regenerated by the scripts in figures/)
figures/out/

# Third-party knowledge graphs are downloaded by the Docker images, never committed.
# A file placed in alzkb/source/, hetionet/data/ or primekg/data/ is used by the
# build when its MD5 matches.
alzkb/*.json*
alzkb/source/*
!alzkb/source/.gitkeep
hetionet/data/*.csv
primekg/data/kg.csv
primekg/data/kg.csv.part
docker-compose.local.yml
